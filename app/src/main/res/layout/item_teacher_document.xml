<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Document Icon -->
        <ImageView
            android:id="@+id/document_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_document_pdf"
            android:scaleType="centerCrop"
            android:background="@drawable/circle_background"
            android:padding="8dp" />

        <!-- Document Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Document Title -->
            <TextView
                android:id="@+id/document_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Educational Certificate"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/textHeading"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- File Name -->
            <TextView
                android:id="@+id/document_filename"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="bsc_certificate.pdf"
                android:textSize="14sp"
                android:textColor="@color/textSecondary"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="middle" />

            <!-- Document Metadata Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <!-- File Type -->
                <TextView
                    android:id="@+id/document_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PDF"
                    android:textSize="12sp"
                    android:textColor="@android:color/white"
                    android:background="@drawable/file_type_bg"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:textStyle="bold" />

                <!-- File Size -->
                <TextView
                    android:id="@+id/document_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2.5 MB"
                    android:textSize="12sp"
                    android:textColor="@color/textSecondary"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/file_size_bg"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />

                <!-- Upload Date -->
                <TextView
                    android:id="@+id/document_upload_date"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="01/08/2023"
                    android:textSize="12sp"
                    android:textColor="@color/textSecondary"
                    android:layout_marginStart="8dp"
                    android:gravity="end" />

            </LinearLayout>

        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <ImageButton
                android:id="@+id/document_download_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_download"
                android:background="@drawable/circle_button_background"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:layout_marginBottom="4dp"
                android:contentDescription="Download Document" />

            <ImageButton
                android:id="@+id/document_view_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_view"
                android:background="@drawable/circle_button_background"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:contentDescription="View Document" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
