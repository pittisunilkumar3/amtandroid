<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Student Profile Image -->
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/student_image"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/placeholder_user"
            android:layout_gravity="center_vertical" />

        <!-- Student Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_gravity="center_vertical">

            <!-- Student Name -->
            <TextView
                android:id="@+id/student_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="John Doe"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/textHeading"
                android:layout_marginBottom="4dp" />

            <!-- Admission Number and Roll Number -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Admission No: "
                    android:textSize="12sp"
                    android:textColor="@color/textSecondary" />

                <TextView
                    android:id="@+id/student_admission_no"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2024001"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/textHeading"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Roll No: "
                    android:textSize="12sp"
                    android:textColor="@color/textSecondary" />

                <TextView
                    android:id="@+id/student_roll_no"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/textHeading" />

            </LinearLayout>

            <!-- Class and Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_fa_graduation_cap"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="4dp"
                    android:tint="@color/colorPrimary" />

                <TextView
                    android:id="@+id/student_class_section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Class 10 - Section A"
                    android:textSize="13sp"
                    android:textColor="@color/textHeading" />

            </LinearLayout>

            <!-- Guardian Information -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_fa_user"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="4dp"
                    android:tint="@color/colorPrimary" />

                <TextView
                    android:id="@+id/student_guardian_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Father: Robert Doe"
                    android:textSize="12sp"
                    android:textColor="@color/textSecondary"
                    android:maxLines="1"
                    android:ellipsize="end" />

            </LinearLayout>

        </LinearLayout>

        <!-- View Details Button -->
        <ImageView
            android:id="@+id/student_view_details"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_arrow_right"
            android:layout_gravity="center_vertical"
            android:padding="8dp"
            android:tint="@color/colorPrimary" />

    </LinearLayout>

</androidx.cardview.widget.CardView>

