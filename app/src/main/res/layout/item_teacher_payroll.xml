<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header Row with Month/Year and Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/payroll_month_year"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="July 2025"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/textHeading" />

            <TextView
                android:id="@+id/payroll_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Generated"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="@drawable/status_generated_bg"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <!-- Payroll Details Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp">

            <!-- First Row: Payslip # and Payment Date -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Payslip #"
                        android:textSize="12sp"
                        android:textColor="@color/textSecondary" />

                    <TextView
                        android:id="@+id/payroll_payslip_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="22"
                        android:textSize="14sp"
                        android:textColor="@color/textHeading"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Payment Date"
                        android:textSize="12sp"
                        android:textColor="@color/textSecondary" />

                    <TextView
                        android:id="@+id/payroll_payment_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="31/07/2025"
                        android:textSize="14sp"
                        android:textColor="@color/textHeading" />

                </LinearLayout>

            </LinearLayout>

            <!-- Second Row: Mode and Net Salary -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mode"
                        android:textSize="12sp"
                        android:textColor="@color/textSecondary" />

                    <TextView
                        android:id="@+id/payroll_mode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Transfer to Bank Account"
                        android:textSize="14sp"
                        android:textColor="@color/textHeading" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Net Salary (₹)"
                        android:textSize="12sp"
                        android:textColor="@color/textSecondary" />

                    <TextView
                        android:id="@+id/payroll_net_salary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹27,000.00"
                        android:textSize="16sp"
                        android:textColor="@color/colorPrimary"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Action Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/payroll_view_button"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="View Payslip"
                android:textSize="12sp"
                android:textColor="@android:color/white"
                android:background="@color/colorPrimary"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:minHeight="0dp"
                style="?android:attr/borderlessButtonStyle" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
