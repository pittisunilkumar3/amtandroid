<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_gradient_full"
    tools:context="com.qdocs.ssre241123.Login">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Logo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="32dp">

            <ImageView
                android:id="@+id/login_logo"
                android:layout_width="180dp"
                android:layout_height="40dp"
                android:src="@drawable/splash_logo"
                android:layout_gravity="center"
                android:contentDescription="Logo" />

        </LinearLayout>

        <!-- Login Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/login_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="28dp">

                <!-- Welcome Text -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome Back"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/textPrimary"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sign in to continue"
                    android:textSize="14sp"
                    android:textColor="@color/textTertiary"
                    android:layout_marginBottom="28dp" />

                <!-- Username Field -->
                <LinearLayout
                    android:id="@+id/layout_username_login"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_input_field"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:id="@+id/icon_username_login"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_user"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="User icon" />

                    <EditText
                        android:id="@+id/et_username_login"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="@string/username"
                        android:textColorHint="@color/textTertiary"
                        android:textSize="15sp"
                        android:textColor="@color/textPrimary"
                        android:singleLine="true"
                        android:inputType="text"
                        android:paddingEnd="16dp" />

                </LinearLayout>

                <!-- Password Field -->
                <LinearLayout
                    android:id="@+id/passwordLayout"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_input_field"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <ImageView
                        android:id="@+id/icon_password_login"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_lock_filled"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="Lock icon" />

                    <EditText
                        android:id="@+id/et_password_login"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="@string/password"
                        android:textColorHint="@color/textTertiary"
                        android:textSize="15sp"
                        android:textColor="@color/textPrimary"
                        android:singleLine="true"
                        android:inputType="textPassword"
                        android:text=""
                        android:fontFamily="sans-serif"
                        android:layout_marginEnd="4dp" />

                    <ImageView
                        android:id="@+id/login_password_visibleBtn"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/eyehide"
                        android:layout_gravity="center"
                        android:layout_marginEnd="8dp"
                        android:padding="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Toggle password" />

                </LinearLayout>

                <!-- Forgot Password -->
                <TextView
                    android:id="@+id/tv_passwordReset_login"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="24dp"
                    android:text="@string/forgotPassword"
                    android:textColor="@color/colorPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:padding="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless" />

                <!-- Login Button -->
                <LinearLayout
                    android:id="@+id/btn_login"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_button_primary"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/login"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.03" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_rightarrow"
                        android:tint="@color/white"
                        android:layout_marginStart="8dp"
                        android:contentDescription="Login" />

                </LinearLayout>

                <!-- Change URL -->
                <LinearLayout
                    android:id="@+id/btn_changeUrl_login"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_web_yellow"
                        android:tint="@color/textTertiary"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="URL" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/changeUrl"
                        android:textColor="@color/textTertiary"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Teacher Login Link -->
        <TextView
            android:id="@+id/go_to_teacher_login_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="8dp"
            android:text="@string/gototeacherlogin"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <!-- Privacy Policy -->
        <TextView
            android:id="@+id/login_privacyTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp"
            android:text="@string/privacyPolicy"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:alpha="0.7"
            android:padding="4dp" />

    </LinearLayout>

</ScrollView>
