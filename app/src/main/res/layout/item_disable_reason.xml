<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:cardUseCompatPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Icon Container -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_circle_primary">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_info"
                android:tint="@android:color/white" />
        </FrameLayout>

        <!-- Content Container -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Reason Text -->
            <TextView
                android:id="@+id/reason_name_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Academic Performance"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- Reason ID -->
            <TextView
                android:id="@+id/reason_id_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID: 1"
                android:textSize="12sp"
                android:textColor="#999999"
                android:layout_marginTop="2dp" />

            <!-- Dates Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp">

                <!-- Created Date -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_calendar"
                        android:tint="#999999"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/reason_created_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Created: Jan 15, 2024"
                        android:textSize="11sp"
                        android:textColor="#999999" />
                </LinearLayout>

                <!-- Updated Date -->
                <LinearLayout
                    android:id="@+id/updated_date_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_calendar"
                        android:tint="#999999"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/reason_updated_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Updated: Jan 15, 2024"
                        android:textSize="11sp"
                        android:textColor="#999999" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="8dp">

            <!-- Edit Button -->
            <ImageView
                android:id="@+id/edit_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="8dp"
                android:src="@drawable/ic_edit"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="#2196F3"
                android:contentDescription="Edit" />

            <!-- Delete Button -->
            <ImageView
                android:id="@+id/delete_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="8dp"
                android:src="@drawable/ic_delete"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="#F44336"
                android:contentDescription="Delete"
                android:layout_marginStart="4dp" />
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>

