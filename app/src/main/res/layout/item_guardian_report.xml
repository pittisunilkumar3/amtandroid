<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Student Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/iv_student_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_fa_user"
                android:padding="8dp"
                android:background="@drawable/circle_background"
                android:tint="@color/blue" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tv_student_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Student Name"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/textPrimary" />

                <TextView
                    android:id="@+id/tv_class_section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Class - Section"
                    android:textSize="14sp"
                    android:textColor="@color/textSecondary"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_active_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Active"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:background="@drawable/bg_status_active"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
        </LinearLayout>

        <!-- Student Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/tv_admission_no"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Adm. No: ADM001"
                android:textSize="14sp"
                android:textColor="@color/textSecondary" />

            <TextView
                android:id="@+id/tv_student_mobile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mobile: 9876543210"
                android:textSize="14sp"
                android:textColor="@color/textSecondary"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp" />

        <!-- Guardian Section -->
        <LinearLayout
            android:id="@+id/guardian_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:id="@+id/tv_guardian_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Guardian"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/blue" />

            <TextView
                android:id="@+id/tv_guardian_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Guardian Name"
                android:textSize="14sp"
                android:textColor="@color/textPrimary"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tv_guardian_relation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Relation: Father"
                android:textSize="13sp"
                android:textColor="@color/textSecondary"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tv_guardian_phone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phone: 9876543210"
                android:textSize="13sp"
                android:textColor="@color/textSecondary"
                android:layout_marginTop="2dp" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp" />
        </LinearLayout>

        <!-- Father Section -->
        <LinearLayout
            android:id="@+id/father_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:id="@+id/tv_father_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Father"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/success" />

            <TextView
                android:id="@+id/tv_father_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Father Name"
                android:textSize="14sp"
                android:textColor="@color/textPrimary"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tv_father_phone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phone: 9876543210"
                android:textSize="13sp"
                android:textColor="@color/textSecondary"
                android:layout_marginTop="2dp" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp" />
        </LinearLayout>

        <!-- Mother Section -->
        <LinearLayout
            android:id="@+id/mother_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:id="@+id/tv_mother_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mother"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/warning" />

            <TextView
                android:id="@+id/tv_mother_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mother Name"
                android:textSize="14sp"
                android:textColor="@color/textPrimary"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tv_mother_phone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phone: 9876543211"
                android:textSize="13sp"
                android:textColor="@color/textSecondary"
                android:layout_marginTop="2dp" />
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>

