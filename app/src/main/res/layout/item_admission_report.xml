<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardUseCompatPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header Section with Theme Color -->
        <LinearLayout
            android:id="@+id/header_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:background="@color/colorPrimary">

            <!-- Student Icon -->
            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/circle_background">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="🎓"
                    android:textSize="28sp" />
            </FrameLayout>

            <!-- Student Name and Admission Number -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Student Name -->
                <TextView
                    android:id="@+id/student_name_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="John Michael Doe"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <!-- Admission Number -->
                <TextView
                    android:id="@+id/admission_no_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Adm. No: 2024001"
                    android:textSize="14sp"
                    android:textColor="#E0E0E0"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Status Badge -->
            <TextView
                android:id="@+id/status_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓ Active"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_status_active"
                android:padding="8dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Content Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#FFFFFF">

            <!-- Admission Date -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp"
                android:background="@drawable/corner"
                android:padding="12dp">

                <TextView
                    android:id="@+id/admission_date_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📅 Admission Date: 2024-04-15"
                    android:textSize="14sp"
                    android:textColor="#333333"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Class and Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/circle_blue"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:id="@+id/class_section_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎓 Class 10 - A"
                    android:textSize="14sp"
                    android:textColor="#2196F3"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Session -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/circle_blue"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:id="@+id/session_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📚 Session: 2024-2025"
                    android:textSize="14sp"
                    android:textColor="#555555" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp" />

            <!-- Guardian Information -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Guardian Information"
                android:textSize="13sp"
                android:textColor="#888888"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- Guardian Name -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/circle_blue"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:id="@+id/guardian_info_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👤 Robert Doe (Father)"
                    android:textSize="14sp"
                    android:textColor="#555555" />
            </LinearLayout>

            <!-- Contact Numbers -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <!-- Student Mobile -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/circle_blue"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:id="@+id/mobile_no_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📱 9876543210"
                        android:textSize="13sp"
                        android:textColor="#555555" />
                </LinearLayout>

                <!-- Guardian Mobile -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/circle_blue"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:id="@+id/guardian_phone_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📞 9876543210"
                        android:textSize="13sp"
                        android:textColor="#555555" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>

