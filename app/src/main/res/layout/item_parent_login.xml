<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:cardUseCompatPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Student Icon -->
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/circle_background">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="👤"
                    android:textSize="24sp" />
            </FrameLayout>

            <!-- Student Name and Details -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Student Name -->
                <TextView
                    android:id="@+id/student_name_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="John Michael Doe"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/textPrimary"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <!-- Class and Section -->
                <TextView
                    android:id="@+id/class_section_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Class 10 - A"
                    android:textSize="14sp"
                    android:textColor="@color/textSecondary"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp" />

        <!-- Student Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Row 1: Admission No and Roll No -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <!-- Admission Number -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:background="@drawable/circle_blue"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/admission_no_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Adm. No: 2024001"
                        android:textSize="13sp"
                        android:textColor="@color/textSecondary" />
                </LinearLayout>

                <!-- Roll Number -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:background="@drawable/circle_blue"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/roll_no_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Roll No: 101"
                        android:textSize="13sp"
                        android:textColor="@color/textSecondary" />
                </LinearLayout>
            </LinearLayout>

            <!-- Row 2: Father Name -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:background="@drawable/circle_blue"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/father_name_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Father: Robert Doe"
                    android:textSize="13sp"
                    android:textColor="@color/textSecondary" />
            </LinearLayout>

            <!-- Row 3: Guardian Name -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:background="@drawable/circle_blue"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/guardian_name_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Guardian: Robert Doe"
                    android:textSize="13sp"
                    android:textColor="@color/textSecondary" />
            </LinearLayout>

            <!-- Row 4: Guardian Phone -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:background="@drawable/circle_blue"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/guardian_phone_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phone: 9876543210"
                    android:textSize="13sp"
                    android:textColor="@color/textSecondary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp" />

        <!-- Login Credentials Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Parent Login Credentials"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/textPrimary"
            android:layout_marginBottom="12dp" />

        <!-- Username Container -->
        <LinearLayout
            android:id="@+id/username_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/rounded_border_bg"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Username"
                    android:textSize="11sp"
                    android:textColor="@color/textTertiary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/username_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="parent123"
                    android:textSize="14sp"
                    android:textColor="@color/textPrimary"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/copy_username_btn"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_fa_copy"
                android:padding="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="@color/blue" />
        </LinearLayout>

        <!-- Password Container -->
        <LinearLayout
            android:id="@+id/password_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/rounded_border_bg"
            android:padding="12dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Password"
                    android:textSize="11sp"
                    android:textColor="@color/textTertiary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/password_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="password123"
                    android:textSize="14sp"
                    android:textColor="@color/textPrimary"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/copy_password_btn"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_fa_copy"
                android:padding="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="@color/blue" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>

