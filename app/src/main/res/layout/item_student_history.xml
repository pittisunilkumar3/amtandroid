<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:cardUseCompatPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Student Icon -->
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/circle_background">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="📚"
                    android:textSize="24sp" />
            </FrameLayout>

            <!-- Student Name and Details -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Student Name -->
                <TextView
                    android:id="@+id/student_name_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="John Michael Doe"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/textPrimary"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <!-- Admission Number -->
                <TextView
                    android:id="@+id/admission_no_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Adm. No: 2024001"
                    android:textSize="13sp"
                    android:textColor="@color/textSecondary"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Admission Date Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/status_generated_bg"
                android:padding="8dp"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Admitted"
                    android:textSize="10sp"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/admission_date_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2024-04-15"
                    android:textSize="11sp"
                    android:textColor="@color/white"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp" />

        <!-- Student Details Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Row 1: Class and Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:background="@drawable/circle_blue"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Class: "
                    android:textSize="13sp"
                    android:textColor="@color/textSecondary" />

                <TextView
                    android:id="@+id/class_section_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Class 10 - A"
                    android:textSize="13sp"
                    android:textColor="@color/blue"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Row 2: Session -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:background="@drawable/circle_blue"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Session: "
                    android:textSize="13sp"
                    android:textColor="@color/textSecondary" />

                <TextView
                    android:id="@+id/session_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2024-2025"
                    android:textSize="13sp"
                    android:textColor="@color/textSecondary" />
            </LinearLayout>

            <!-- Row 3: Guardian Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:background="@drawable/circle_blue"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/guardian_info_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Guardian: Robert Doe (Father)"
                    android:textSize="13sp"
                    android:textColor="@color/textSecondary" />
            </LinearLayout>

            <!-- Row 4: Contact Numbers -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <!-- Student Mobile -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:background="@drawable/circle_blue"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/mobile_no_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📱 9876543210"
                        android:textSize="13sp"
                        android:textColor="@color/textSecondary" />
                </LinearLayout>

                <!-- Guardian Mobile -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:background="@drawable/circle_blue"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/guardian_phone_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📞 9876543210"
                        android:textSize="13sp"
                        android:textColor="@color/textSecondary" />
                </LinearLayout>
            </LinearLayout>

            <!-- Row 5: Status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:background="@drawable/circle_blue"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status: "
                    android:textSize="13sp"
                    android:textColor="@color/textSecondary" />

                <TextView
                    android:id="@+id/status_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Active"
                    android:textSize="13sp"
                    android:textColor="@color/success"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>

