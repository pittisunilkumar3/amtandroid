<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundMain">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:contentScrim="@color/colorPrimary"
            app:expandedTitleMarginEnd="64dp"
            app:expandedTitleMarginStart="48dp"
            app:layout_scrollFlags="scroll|exitUntilCollapsed">

            <!-- Header Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_gradient_primary"
                android:orientation="vertical"
                android:paddingTop="16dp"
                android:paddingBottom="24dp"
                app:layout_collapseMode="parallax">

                <!-- Toolbar Row -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:id="@+id/drawer_indicator"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="12dp"
                        android:scaleType="centerInside"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:tint="@android:color/white"
                        android:layout_centerVertical="true"
                        android:layout_alignParentStart="true"
                        android:contentDescription="Menu" />

                    <ImageView
                        android:id="@+id/actionBar_logo"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_toEndOf="@+id/drawer_indicator"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="4dp"
                        android:maxWidth="200dp"
                        android:minWidth="120dp"
                        android:src="@drawable/splash_logo"
                        android:scaleType="fitStart"
                        android:adjustViewBounds="true"
                        android:contentDescription="Logo" />

                    <FrameLayout
                        android:id="@+id/notification_alert"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:clipToPadding="false"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:padding="8dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:tint="@android:color/white"
                            android:src="@drawable/ic_add_alert"
                            android:contentDescription="Notifications" />

                        <TextView
                            android:id="@+id/unread_count"
                            android:layout_width="18dp"
                            android:layout_height="17dp"
                            android:layout_gravity="right|end|top"
                            android:layout_marginStart="18dp"
                            android:background="@drawable/bg_badge"
                            android:gravity="center"
                            android:padding="4dp"
                            android:text=""
                            android:visibility="gone"
                            android:textColor="@android:color/white"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </FrameLayout>
                </RelativeLayout>

                <!-- Profile Section -->
                <LinearLayout
                    android:id="@+id/linear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginTop="8dp">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/patientProfile_profileImageview"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_gravity="center"
                        android:src="@drawable/placeholder_user"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Karan Sharma"
                        android:textColor="@android:color/white"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.01" />

                    <TextView
                        android:id="@+id/admissionno"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="4dp"
                        android:text="Admission No. 1800 • Class 1-A"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:alpha="0.85" />
                </LinearLayout>

            </LinearLayout>

            <!-- Actual Toolbar (collapsed) -->
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_scrollFlags="scroll|enterAlways"
                app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Recently Used Section -->
            <androidx.cardview.widget.CardView
                style="@style/CustomCardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recently Used"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/textPrimary"
                        android:layout_marginBottom="16dp" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- E-Connect -->
                            <LinearLayout
                                android:layout_width="72dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="16dp"
                                android:gravity="center"
                                android:orientation="vertical">

                                <FrameLayout
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:background="@drawable/bg_circle_blue">
                                    <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_online_exams"
                                        android:tint="@color/cardBlueIcon" />
                                </FrameLayout>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:gravity="center"
                                    android:text="E-Connect"
                                    android:textColor="@color/textSecondary"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <!-- Homework -->
                            <LinearLayout
                                android:layout_width="72dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="16dp"
                                android:gravity="center"
                                android:orientation="vertical">

                                <FrameLayout
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:background="@drawable/bg_circle_green">
                                    <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_dashboard_homework"
                                        android:tint="@color/cardGreenIcon" />
                                </FrameLayout>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:gravity="center"
                                    android:text="Homework"
                                    android:textColor="@color/textSecondary"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <!-- Attendance -->
                            <LinearLayout
                                android:layout_width="72dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="16dp"
                                android:gravity="center"
                                android:orientation="vertical">

                                <FrameLayout
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:background="@drawable/bg_circle_purple">
                                    <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_dashboard_attendance"
                                        android:tint="@color/cardPurpleIcon" />
                                </FrameLayout>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:gravity="center"
                                    android:text="Attendance"
                                    android:textColor="@color/textSecondary"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <!-- Marks -->
                            <LinearLayout
                                android:layout_width="72dp"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="vertical">

                                <FrameLayout
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:background="@drawable/bg_circle_orange">
                                    <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_open_book"
                                        android:tint="@color/cardOrangeIcon" />
                                </FrameLayout>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:gravity="center"
                                    android:text="Marks"
                                    android:textColor="@color/textSecondary"
                                    android:textSize="11sp" />
                            </LinearLayout>

                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Academic Section -->
            <androidx.cardview.widget.CardView
                style="@style/CustomCardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Academic"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/textPrimary"
                        android:layout_marginBottom="16dp" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- Timetable -->
                            <LinearLayout
                                android:layout_width="72dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="16dp"
                                android:gravity="center"
                                android:orientation="vertical">
                                <FrameLayout
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:background="@drawable/bg_circle_teal">
                                    <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_nav_timeline"
                                        android:tint="@color/cardTealIcon" />
                                </FrameLayout>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:gravity="center"
                                    android:text="Timetable"
                                    android:textColor="@color/textSecondary"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <!-- Homework -->
                            <LinearLayout
                                android:layout_width="72dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="16dp"
                                android:gravity="center"
                                android:orientation="vertical">
                                <FrameLayout
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:background="@drawable/bg_circle_pink">
                                    <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_dashboard_homework"
                                        android:tint="@color/cardPinkIcon" />
                                </FrameLayout>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:gravity="center"
                                    android:text="Homework"
                                    android:textColor="@color/textSecondary"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <!-- Examination -->
                            <LinearLayout
                                android:layout_width="72dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="16dp"
                                android:gravity="center"
                                android:orientation="vertical">
                                <FrameLayout
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:background="@drawable/bg_circle_red">
                                    <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_nav_examination"
                                        android:tint="@color/cardRedIcon" />
                                </FrameLayout>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:gravity="center"
                                    android:text="Exams"
                                    android:textColor="@color/textSecondary"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <!-- Marks -->
                            <LinearLayout
                                android:layout_width="72dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="16dp"
                                android:gravity="center"
                                android:orientation="vertical">
                                <FrameLayout
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:background="@drawable/bg_circle_yellow">
                                    <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_open_book"
                                        android:tint="@color/cardYellowIcon" />
                                </FrameLayout>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:gravity="center"
                                    android:text="Marks"
                                    android:textColor="@color/textSecondary"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <!-- Online Exam -->
                            <LinearLayout
                                android:layout_width="72dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="16dp"
                                android:gravity="center"
                                android:orientation="vertical">
                                <FrameLayout
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:background="@drawable/bg_circle_blue">
                                    <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_online_exams"
                                        android:tint="@color/cardBlueIcon" />
                                </FrameLayout>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:gravity="center"
                                    android:text="Online Exam"
                                    android:textColor="@color/textSecondary"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <!-- Online Course -->
                            <LinearLayout
                                android:layout_width="72dp"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="vertical">
                                <FrameLayout
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:background="@drawable/bg_circle_green">
                                    <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_onlinecourse"
                                        android:tint="@color/cardGreenIcon" />
                                </FrameLayout>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:gravity="center"
                                    android:text="Online Course"
                                    android:textColor="@color/textSecondary"
                                    android:textSize="11sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- E-Learning Section -->
            <androidx.cardview.widget.CardView
                style="@style/CustomCardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="E-Learning"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/textPrimary"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="4">

                        <!-- Online Exam -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">
                            <FrameLayout
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_circle_purple">
                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_online_exams"
                                    android:tint="@color/cardPurpleIcon" />
                            </FrameLayout>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center"
                                android:text="Online Exam"
                                android:textColor="@color/textSecondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- Online Course -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">
                            <FrameLayout
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_circle_teal">
                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_onlinecourse"
                                    android:tint="@color/cardTealIcon" />
                            </FrameLayout>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center"
                                android:text="Online Course"
                                android:textColor="@color/textSecondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- Attendance -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">
                            <FrameLayout
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_circle_green">
                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_dashboard_attendance"
                                    android:tint="@color/cardGreenIcon" />
                            </FrameLayout>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center"
                                android:text="Attendance"
                                android:textColor="@color/textSecondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- Marks -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">
                            <FrameLayout
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_circle_orange">
                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_open_book"
                                    android:tint="@color/cardOrangeIcon" />
                            </FrameLayout>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center"
                                android:text="Marks"
                                android:textColor="@color/textSecondary"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
