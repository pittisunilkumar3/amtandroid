<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/img_background_main">

    <androidx.cardview.widget.CardView
        android:id="@+id/card_view_outer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="2dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardPreventCornerOverlap="false"
                    android:elevation="2dp"
                    android:layout_marginEnd="@dimen/card_end"
                    android:layout_marginStart="@dimen/card_start"
                    app:cardCornerRadius="16dp">

                    <RelativeLayout
                        android:id="@+id/teacher_profile_headerLayout"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="15dp"
                        android:background="@color/white">

                        <RelativeLayout
                            android:id="@+id/teacher_profile_details"
                            android:layout_width="200dp"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="10dp">

                            <TextView
                                android:id="@+id/teacher_profile_nameTV"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Teacher Name"
                                android:textColor="@color/textHeading"
                                android:textSize="@dimen/largeheading"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/teacher_profile_designationTV"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_below="@+id/teacher_profile_nameTV"
                                android:layout_marginTop="5dp"
                                android:text="Designation"
                                android:textColor="@color/textHeading"
                                android:textSize="@dimen/secondaryText" />

                            <TextView
                                android:id="@+id/teacher_profile_employeeIdHeader"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@+id/teacher_profile_designationTV"
                                android:layout_marginTop="5dp"
                                android:layout_marginEnd="5dp"
                                android:text="Emp. ID:"
                                android:textColor="@color/textHeading"
                                android:textSize="@dimen/secondaryText" />

                            <TextView
                                android:id="@+id/teacher_profile_employeeIdTV"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@+id/teacher_profile_designationTV"
                                android:layout_toEndOf="@id/teacher_profile_employeeIdHeader"
                                android:text="EMP001"
                                android:layout_marginTop="5dp"
                                android:textColor="@color/textHeading"
                                android:textSize="@dimen/secondaryText" />

                        </RelativeLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:gravity="center"
                            android:layout_toEndOf="@id/teacher_profile_details"
                            android:orientation="vertical">

                            <de.hdodenhof.circleimageview.CircleImageView
                                android:id="@+id/teacher_profile_imageIV"
                                android:layout_width="100dp"
                                android:layout_height="100dp"
                                android:src="@drawable/demo" />

                        </LinearLayout>

                    </RelativeLayout>

                </androidx.cardview.widget.CardView>

                <!-- QR Code Section - Matching Student Profile Layout -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:elevation="2dp"
                    app:cardElevation="2dp"
                    android:layout_margin="10dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="15dp">

                        <LinearLayout
                            android:id="@+id/teacher_qrcode_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/teacherProfile_qrcodeHeader"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:layout_marginEnd="5dp"
                                android:text="@string/qrcode"
                                android:textColor="@color/textHeading"
                                android:textSize="@dimen/secondaryText" />

                            <ImageView
                                android:id="@+id/teacherProfile_qrcodeIV"
                                android:layout_width="100dp"
                                android:layout_height="50dp"
                                android:text="@string/empty"
                                android:textColor="@color/textHeading"
                                android:textSize="@dimen/secondaryText" />

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Tab Layout and ViewPager Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.google.android.material.tabs.TabLayout
                            android:id="@+id/teacherProfileTabLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:tabMode="scrollable"
                            app:tabGravity="fill"
                            app:tabTextAppearance="@style/CustomTablayout" />
                    </LinearLayout>

                    <androidx.viewpager.widget.ViewPager
                        android:id="@+id/teacherProfileViewPager"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="10dp"
                        app:layout_behavior="@string/appbar_scrolling_view_behavior" />
                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </androidx.cardview.widget.CardView>

</LinearLayout>
