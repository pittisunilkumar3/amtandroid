<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/backgroundMain">

    <!-- Modern Toolbar -->
    <LinearLayout
        android:id="@+id/actionBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@drawable/bg_gradient_primary"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="16dp"
        android:elevation="1dp">

        <ImageView
            android:id="@+id/crud_back_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@android:color/white" />

        <TextView
            android:id="@+id/crud_title_textview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Manage"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:ellipsize="end"
             />

        <ImageView
            android:id="@+id/crud_search_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_fa_search"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@android:color/white"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Main Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Form Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/crud_form_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeWidth="1dp"
                app:strokeColor="@color/surfaceContainerHigh">

                <LinearLayout
                    android:id="@+id/crud_form_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Form Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_gradient_primary">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_fa_plus"
                                android:tint="@android:color/white" />

                        </FrameLayout>

                        <TextView
                            android:id="@+id/crud_form_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Add New"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="@color/textPrimary"
                            android:layout_marginStart="12dp" />

                    </LinearLayout>

                    <!-- Name Input -->
                    <EditText
                        android:id="@+id/crud_name_input"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_input_field"
                        android:hint="Enter name"
                        android:textColorHint="@color/textTertiary"
                        android:textColor="@color/textPrimary"
                        android:textSize="15sp"
                        android:inputType="text"
                        android:maxLines="1"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:layout_marginBottom="12dp" />

                    <SwitchCompat
                        android:id="@+id/crud_active_switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Active"
                        android:textColor="@color/textPrimary"
                        android:textSize="14sp"
                        android:layout_marginBottom="16dp"
                        android:checked="true" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="end"
                        android:layout_marginTop="4dp">

                        <Button
                            android:id="@+id/crud_cancel_button"
                            style="@style/Widget.AppCompat.Button.Borderless"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:text="Cancel"
                            android:textColor="@color/textSecondary"
                            android:textAllCaps="false" />

                        <Button
                            android:id="@+id/crud_save_button"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:text="Save"
                            android:textColor="@android:color/white"
                            android:textAllCaps="false"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_button_primary" />

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Header -->
            <LinearLayout
                android:id="@+id/crud_header_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/crud_count_textview"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0 item(s)"
                    android:textSize="14sp"
                    android:textColor="@color/textSecondary" />

                <Button
                    android:id="@+id/crud_add_button"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="+ Add"
                    android:textSize="13sp"
                    android:textColor="@android:color/white"
                    android:textAllCaps="false"
                    android:minWidth="0dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:minHeight="0dp"
                    android:background="@drawable/bg_button_primary" />

            </LinearLayout>

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/crud_progress_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="40dp"
                android:indeterminateTint="@color/colorPrimary"
                android:visibility="gone" />

            <!-- No Data -->
            <LinearLayout
                android:id="@+id/crud_nodata_layout"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_circle_blue">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_fa_inbox"
                        android:tint="@color/cardBlueIcon"
                        android:alpha="0.6" />

                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No items found"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/textPrimary"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap + Add to create one"
                    android:textSize="13sp"
                    android:textColor="@color/textSecondary" />

            </LinearLayout>

            <!-- List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/crud_recyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
