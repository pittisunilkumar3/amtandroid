<resources>

    <!-- Base application theme - Modern Material Design 3 -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:typeface">sans</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="android:windowBackground">@color/backgroundMain</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />
    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <!-- ===== Button Styles ===== -->

    <!-- Primary Button -->
    <style name="ButtonPrimary" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/labelLarge</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingStart">@dimen/spacing_xl</item>
        <item name="android:paddingEnd">@dimen/spacing_xl</item>
    </style>

    <!-- Secondary Button -->
    <style name="ButtonSecondary" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/labelLarge</item>
        <item name="android:minHeight">@dimen/button_height</item>
    </style>

    <!-- Danger Button -->
    <style name="ButtonDanger" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_danger</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/labelLarge</item>
        <item name="android:minHeight">@dimen/button_height</item>
    </style>

    <!-- Small Button (for cards/list items) -->
    <style name="ButtonSmall" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/labelMedium</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">@dimen/spacing_base</item>
        <item name="android:paddingEnd">@dimen/spacing_base</item>
        <item name="android:paddingTop">@dimen/spacing_sm</item>
        <item name="android:paddingBottom">@dimen/spacing_sm</item>
    </style>

    <!-- ===== Card Styles ===== -->

    <style name="CardSurface" parent="CardView">
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="android:layout_marginStart">@dimen/spacing_md</item>
        <item name="android:layout_marginEnd">@dimen/spacing_md</item>
        <item name="android:layout_marginTop">@dimen/spacing_xs</item>
        <item name="android:layout_marginBottom">@dimen/spacing_xs</item>
    </style>

    <style name="CardElevated" parent="CardView">
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
    </style>

    <style name="CustomCardView" parent="CardView">
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="android:layout_marginStart">@dimen/spacing_base</item>
        <item name="android:layout_marginEnd">@dimen/spacing_base</item>
        <item name="android:layout_marginTop">@dimen/spacing_sm</item>
        <item name="android:layout_marginBottom">@dimen/spacing_sm</item>
    </style>

    <!-- ===== Text Styles (MD3 Typography) ===== -->

    <style name="TextHeading1">
        <item name="android:textSize">@dimen/headlineSmall</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="TextHeading2">
        <item name="android:textSize">@dimen/titleLarge</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingExtra">1dp</item>
    </style>

    <style name="TextHeading3">
        <item name="android:textSize">@dimen/titleMedium</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextBody1">
        <item name="android:textSize">@dimen/bodyLarge</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="TextBody2">
        <item name="android:textSize">@dimen/bodyMedium</item>
        <item name="android:textColor">@color/textSecondary</item>
        <item name="android:lineSpacingExtra">1dp</item>
    </style>

    <style name="TextCaption">
        <item name="android:textSize">@dimen/labelSmall</item>
        <item name="android:textColor">@color/textTertiary</item>
    </style>

    <style name="TextOverline">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/textTertiary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <style name="TextButton">
        <item name="android:textSize">@dimen/labelLarge</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- TextInputLayout wrapper (replaces broken OutlinedBox) -->
    <style name="InputFieldContainer" parent="Widget.Design.TextInputLayout">
        <item name="android:textColorHint">@color/textTertiary</item>
        <item name="hintTextAppearance">@style/TextCaption</item>
    </style>

    <!-- ===== Input Styles ===== -->

    <style name="InputField" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input_field</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textColorHint">@color/textTertiary</item>
        <item name="android:textSize">@dimen/bodyLarge</item>
        <item name="android:paddingStart">@dimen/spacing_base</item>
        <item name="android:paddingEnd">@dimen/spacing_base</item>
        <item name="android:paddingTop">@dimen/spacing_md</item>
        <item name="android:paddingBottom">@dimen/spacing_md</item>
        <item name="android:minHeight">@dimen/input_height</item>
    </style>

    <style name="InputFieldMultiline" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input_field</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textColorHint">@color/textTertiary</item>
        <item name="android:textSize">@dimen/bodyLarge</item>
        <item name="android:paddingStart">@dimen/spacing_base</item>
        <item name="android:paddingEnd">@dimen/spacing_base</item>
        <item name="android:paddingTop">@dimen/spacing_md</item>
        <item name="android:paddingBottom">@dimen/spacing_md</item>
        <item name="android:minHeight">120dp</item>
        <item name="android:gravity">start</item>
    </style>

    <!-- ===== Toolbar Styles ===== -->

    <style name="ToolbarTitle">
        <item name="android:textSize">@dimen/titleMedium</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="SectionHeader">
        <item name="android:textSize">@dimen/titleMedium</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginBottom">@dimen/spacing_sm</item>
    </style>

    <!-- ===== Badge/Chip ===== -->
    <style name="BadgePrimary">
        <item name="android:textSize">@dimen/labelSmall</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:paddingStart">@dimen/spacing_md</item>
        <item name="android:paddingEnd">@dimen/spacing_md</item>
        <item name="android:paddingTop">@dimen/spacing_xs</item>
        <item name="android:paddingBottom">@dimen/spacing_xs</item>
    </style>

    <!-- ===== Calendar Styles ===== -->
    <style name="RobotoCalendarMonthText">
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="RobotoCalendarMonthArrow">
        <item name="android:tint">@color/colorPrimary</item>
    </style>

    <style name="RobotoCalendarDayOfTheWeekText">
        <item name="android:textSize">@dimen/roboto_calendar_day_of_week_font</item>
        <item name="android:textColor">@color/textSecondary</item>
    </style>

    <style name="RobotoCalendarDayOfTheMonthText">
        <item name="android:textSize">@dimen/roboto_calendar_day_of_the_month_font</item>
        <item name="android:textColor">@color/textPrimary</item>
    </style>

    <!-- ===== Tab & Navigation ===== -->
    <style name="CustomTablayout" parent="TextAppearance.Design.Tab">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/labelMedium</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <style name="customRatingBar" parent="android:style/Widget.Material.RatingBar.Small">
    </style>

    <style name="BottomNavigationActive">
        <item name="android:textSize">10sp</item>
        <item name="android:padding">0dp</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="BottomNavigationInactive">
        <item name="android:textSize">10sp</item>
        <item name="android:padding">0dp</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="NavigationTheme" parent="AppTheme">
        <item name="android:textSize">@dimen/primaryText</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="NavTextAppearance" parent="AppTheme">
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/textPrimary</item>
    </style>

</resources>
